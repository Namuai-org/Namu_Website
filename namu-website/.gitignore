# OS cruft
.DS_Store

# Never commit credentials. This file sits in public/, so committing it would
# also publish it at the site root on every deploy.
public/*_accessKeys.csv
public/**/*accessKeys*

# Anything in public/ is served unauthenticated at the site root, so documents
# staged there are published the moment they are committed. Keep internal
# material out by default; add a specific negation if a document is genuinely
# meant to be downloadable.
public/*.docx
public/*.doc
public/*.pptx
public/*.xlsx
public/*.pdf

